# --- Personal / never tracked ---
# Any folder named "untracked", at any depth.
untracked/

# --- Secrets ---
.env
.env.*

# --- Python ---
__pycache__/
*.py[cod]

# --- Virtual environments ---
.venv/
venv/
# NOTE: .python-version is intentionally TRACKED (pins the interpreter).

# --- Packaging ---
*.egg-info/
dist/
build/

# --- Tool caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Training artifacts (regenerated by running the notebooks) ---
logs/
*.tfevents.*
*.pkl
*.zip

# --- OS / editors ---
.DS_Store
.vscode/
.idea/

# --- Logs ---
*.log
